+++ b/tests/unit/_probe_ring.mjs
@@ -0,0 +1,15 @@
+import "./dom-stub.mjs";
+import * as THREE from "three";
+globalThis.LOFT_OUT = process.argv[2]; globalThis.LOFT_DECK = true;
+const { buildSite, createWalker } = await import("../../app/src/site.js");
+const M = new Proxy({}, { get: (t, k) => (k === "plaster" || k === "interior" ? () => (t["__" + k] ||= new THREE.MeshBasicMaterial()) : (t[k] ||= new THREE.MeshBasicMaterial())) });
+const site = buildSite(M), w = createWalker(site), cz = -131.3, H = 35.31, st = 0.04;
+const ok = (x, z) => !w.blocked(x, z) && Math.abs(w.heightAt(x, z) - H) < 1e-6;
+const cells = new Set(), key = (i, j) => i + "," + j, all = [];
+for (let i = -150; i <= 150; i++) for (let j = -150; j <= 150; j++) { const x = i * st, z = cz + j * st; if (ok(x, z)) { cells.add(key(i, j)); all.push([i, j]); } }
+const start = all.find(([i, j]) => i === 0 && j > 0); const seen = new Set([key(...start)]), q = [start];
+while (q.length) { const [i, j] = q.pop(); for (const [a, b] of [[1,0],[-1,0],[0,1],[0,-1]]) { const k = key(i + a, j + b); if (cells.has(k) && !seen.has(k)) { seen.add(k); q.push([i + a, j + b]); } } }
+// narrowest: min free width in front of the columns
+let minAtCol = Infinity; for (const x of [-3.4,-1.2,1.2,3.4]) { let n = 0; for (let j = 0; j < 150; j++) if (cells.has(key(Math.round(x / st), j))) n++; minAtCol = Math.min(minAtCol, n * st); }
+let mid = 0; for (let j = 0; j < 150; j++) if (cells.has(key(Math.round(2.3 / st), j))) mid++;
+console.log({ out: process.argv[2], standable: all.length, connected: seen.size, allConnected: seen.size === all.length, widthAtColumn: +minAtCol.toFixed(2), widthBetween: +(mid * st).toFixed(2), corners: [[1,1],[1,-1],[-1,1],[-1,-1]].map(([a,b]) => cells.has(key(Math.round(a*4.1/st), Math.round(b*4.1/st)))) });
