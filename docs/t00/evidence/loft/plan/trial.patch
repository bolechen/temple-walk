diff --git a/tools/_loft_plan.cjs b/tools/_loft_plan.cjs
new file mode 100644
index 0000000..874014f
--- /dev/null
+++ b/tools/_loft_plan.cjs
@@ -0,0 +1,47 @@
+// TRIAL (issue #101 plan stage, not committed as a tool): renders the comparison set with the top gallery at
+// LOFT_OUT metres, injected before the page runs. usage: node tools/_loft_plan.cjs <out> <platOut> [deck] [names...]
+const { chromium } = require("playwright");
+const http = require("http"), fs = require("fs"), path = require("path");
+const root = require("./site.cjs").site();
+const [outDir, platOut, deck, ...names] = process.argv.slice(2);
+const types = { ".html": "text/html", ".js": "text/javascript", ".json": "application/json", ".webp": "image/webp", ".css": "text/css", ".woff2": "font/woff2", ".wasm": "application/wasm" };
+const srv = http.createServer((req, res) => {
+  let p = null; try { const rel = decodeURIComponent(req.url.split("?")[0]).replace(/^\/$/, "/index.html"), base = path.resolve(root), full = path.resolve(base, "." + path.posix.normalize("/" + rel)); if (full.startsWith(base + path.sep)) p = full; } catch {}
+  if (!p || !fs.existsSync(p) || fs.statSync(p).isDirectory()) { res.writeHead(404); return res.end(); }
+  res.writeHead(200, { "content-type": types[path.extname(p)] || "application/octet-stream" }); fs.createReadStream(p).pipe(res);
+});
+(async () => {
+  await new Promise((r) => srv.listen(0, "127.0.0.1", r)); fs.mkdirSync(outDir, { recursive: true });
+  const port = srv.address().port, base = `http://127.0.0.1:${port}/`, bench = `http://pr-1-temple-walk-preview.test:${port}/`;
+  const b = await chromium.launch({ args: ["--use-gl=swiftshader", "--enable-unsafe-swiftshader", "--ignore-gpu-blocklist", `--host-resolver-rules=MAP pr-1-temple-walk-preview.test 127.0.0.1`] });
+  const report = {};
+  for (const name of names) {
+    const [kind, arg = "", size = "wide"] = name.split(":");
+    const vp = size === "tall" ? { width: 390, height: 844 } : { width: 1280, height: 720 };
+    const p = await b.newPage({ viewport: vp, deviceScaleFactor: 1, locale: "zh-CN" });
+    const errs = []; p.on("pageerror", (e) => errs.push(e.message)); p.on("console", (m) => m.type() === "error" && errs.push(m.text().slice(0, 300)));
+    await p.addInitScript(([o, d]) => { globalThis.LOFT_OUT = o; globalThis.LOFT_DECK = d === "deck"; }, [platOut, deck]);
+    const frames = async (n) => { const f0 = await p.evaluate(() => window.__yard().frames); await p.waitForFunction((f) => window.__yard().frames >= f, f0 + n, { timeout: 300000, polling: 200 }); };
+    if (kind === "ending") {
+      await p.goto(`${bench}?q=high&debug=0&seals=bell&play=ending&season=summer&time=day`, { waitUntil: "commit", timeout: 240000 });
+      await p.waitForFunction(() => window.__rites && window.__rites().closing, null, { timeout: 400000, polling: 300 });
+      await p.evaluate(() => window.__riteClock(0)); await frames(2);
+      const u0 = await p.evaluate(() => window.__rites().close.u);
+      await p.evaluate((ms) => window.__riteClock(ms), Math.max(0, (0.97 - u0) * 30000)); await frames(4); await p.waitForTimeout(800);
+      console.log("close", JSON.stringify(await p.evaluate(() => window.__rites().close)));
+    } else {
+      // view: a named view (`show`) or a camera (`cam`), a season-hour and a view (first|third)
+      const [where, when = "", vw = ""] = arg.split("@"), [season, time] = when.split("-");
+      const q = where.includes(",") ? `cam=${where}` : `show=${where}`;
+      await p.goto(`${base}?shot=1&q=high&${q}` + (season ? `&season=${season}&time=${time}` : "") + (vw ? `&view=${vw}` : ""), { waitUntil: "commit", timeout: 240000 });
+      await p.waitForFunction(() => document.body.dataset.ready === "1", null, { timeout: 300000 }); await frames(3); await p.waitForTimeout(1200);
+    }
+    const file = path.join(outDir, `${kind}-${(arg || "last").replace(/[@,]/g, "_")}-${size}.png`);
+    await p.screenshot({ path: file, timeout: 240000 });
+    const y = await p.evaluate(() => { const y = window.__yard(); return { tris: y.tris, calls: y.calls, x: y.x, z: y.z, h: y.h }; });
+    report[path.basename(file)] = { ...y, errors: errs.slice(0, 4) }; console.log(path.basename(file), JSON.stringify(report[path.basename(file)]));
+    await p.close();
+  }
+  fs.writeFileSync(path.join(outDir, `report-${platOut}.json`), JSON.stringify(report, null, 1));
+  await b.close(); srv.close();
+})();
