// Generated by tools/app.mjs. The built site, served at mygo://localhost/, and the update check.
package main

import (
	"context"
	"embed"
	"fmt"
	"io"
	"io/fs"
	"log"
	"net/http"
	"net/url"
	"os"
	"path/filepath"
	"runtime"
	"time"

	"github.com/egoist/mygo"
)

//go:embed all:site
var site embed.FS

// localFeed, set by MYGO_LOCAL_FEED, reads the same manifests and archives from another host. It exists for
// replaying an update on a machine whose DNS cannot point the real feed at a local server; the manifests, the
// archives and their signatures are the ones `mygo build` wrote. It is inert in a normal run.
type localFeed struct{ base *url.URL }

func (s localFeed) Manifest(ctx context.Context, _ bool) (io.ReadCloser, error) {
	name := "update-" + runtime.GOOS + "-" + runtime.GOARCH + ".json"
	return s.Open(ctx, s.base.JoinPath(name).String())
}

func (s localFeed) Open(ctx context.Context, raw string) (io.ReadCloser, error) {
	u, err := url.Parse(raw)
	if err != nil {
		return nil, err
	}
	u.Scheme, u.Host = s.base.Scheme, s.base.Host
	req, err := http.NewRequestWithContext(ctx, http.MethodGet, u.String(), nil)
	if err != nil {
		return nil, err
	}
	resp, err := http.DefaultClient.Do(req)
	if err != nil {
		return nil, err
	}
	if resp.StatusCode != http.StatusOK {
		resp.Body.Close()
		return nil, fmt.Errorf("GET %s: %s", u, resp.Status)
	}
	return resp.Body, nil
}

func main() {
	front, err := fs.Sub(site, "site")
	if err != nil {
		log.Fatal(err)
	}
	mygo.SetFrontend(front)
	if local := os.Getenv("MYGO_LOCAL_FEED"); local != "" {
		if u, err := url.Parse(local); err == nil {
			mygo.Updater.SetSource(localFeed{base: u})
		}
	}
	mygo.App.WhenReady(func() {
		logStep("running version %s", mygo.App.Version())
		mygo.NewWindow(mygo.WindowOptions{
			Title:     "山门之外",
			URL:       "/",
			Width:     1440,
			Height:    900,
			MinWidth:  960,
			MinHeight: 600,
		})
		go checkForUpdates()
	})
	if err := mygo.App.Run(); err != nil {
		log.Fatal(err)
	}
}

// logStep appends to update.log in the app's data directory, across relaunches.
func logStep(format string, a ...any) {
	dir, err := mygo.App.Path(mygo.PathUserData)
	if err != nil {
		return
	}
	f, err := os.OpenFile(filepath.Join(dir, "update.log"), os.O_APPEND|os.O_CREATE|os.O_WRONLY, 0o644)
	if err != nil {
		return
	}
	defer f.Close()
	fmt.Fprintf(f, "%s %s\n", time.Now().Format("2006-01-02 15:04:05"), fmt.Sprintf(format, a...))
}

// checkForUpdates asks the feed once, installs what it finds, and relaunches.
func checkForUpdates() {
	time.Sleep(3 * time.Second)
	ctx, cancel := context.WithTimeout(context.Background(), 2*time.Minute)
	defer cancel()
	logStep("check: enabled=%v", mygo.Updater.Enabled())
	up, err := mygo.Updater.Check(ctx)
	if err != nil {
		logStep("check: error: %v", err)
		return
	}
	if up == nil {
		logStep("check: up to date")
		return
	}
	logStep("check: found %s", up.Version)
	if err := up.Install(ctx, func(downloaded, total int64) {}); err != nil {
		logStep("install: error: %v", err)
		return
	}
	logStep("install: %s done, relaunching", up.Version)
	mygo.App.Relaunch()
}
