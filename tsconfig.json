{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "skipLibCheck": true,
    "types": [
      "vite/client"
    ]
  },
  "include": [
    "app/src/**/*.js",
    "app/src/globals.d.ts",
    "app/yard.js",
    "app/shared/textures/index.js"
  ],
  "exclude": [
    "app/vendor",
    "dist"
  ]
}