{
  "name": "temple-walk",
  "version": "0.1.1",
  "private": true,
  "description": "A walk through a code-built mountain temple, in the browser",
  "scripts": {
    "check": "node tools/check.cjs",
    "test": "node --test tests/unit/*.test.mjs",
    "e2e": "node tests/e2e/run.cjs",
    "e2e:smoke": "node tests/e2e/run.cjs --smoke",
    "e2e:quick": "node tests/e2e/run.cjs --quick",
    "verify": "pnpm run check && pnpm test && pnpm run e2e:smoke",
    "shots": "node tools/shots.js",
    "portrait": "node tools/portrait.js",
    "serve": "python3 -m http.server 8000 --bind 127.0.0.1 --directory app",
    "setup": "node tools/setup.mjs",
    "postinstall": "node tools/setup.mjs",
    "edges": "node tools/edges.mjs"
  },
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "three": "0.186.0"
  },
  "devDependencies": {
    "playwright": "1.63.0"
  }
}
