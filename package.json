{
  "name": "temple-walk",
  "version": "0.1.1",
  "private": true,
  "description": "A walk through a code-built mountain temple, in the browser",
  "scripts": {
    "check": "node tools/check.cjs",
    "test": "node --test tests/unit/*.test.mjs",
    "e2e": "node tests/e2e/run.cjs",
    "e2e:smoke": "node tests/e2e/run.cjs --smoke",
    "e2e:quick": "node tests/e2e/run.cjs --quick",
    "verify": "pnpm run check && pnpm run typecheck && pnpm test && pnpm run e2e:smoke",
    "shots": "node tools/shots.js",
    "portrait": "node tools/portrait.js",
    "music": "node tools/music.mjs",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "serve": "vite",
    "typecheck": "tsc -p tsconfig.json",
    "setup": "node tools/setup.mjs",
    "postinstall": "node tools/setup.mjs",
    "edges": "node tools/edges.mjs",
    "nearplane": "node --test tests/slow/*.test.mjs"
  },
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "three": "0.186.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/three": "~0.186.0",
    "meshoptimizer": "^1.3.0",
    "playwright": "1.63.0",
    "sharp": "^0.35.5",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}
